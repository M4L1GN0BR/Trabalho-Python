# Chave da API DeepSeek (obrigatória para funcionalidades de IA)
DEEPSEEK_API_KEY=sua_chave_aqui

# Modelo DeepSeek (opcional, padrão: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

